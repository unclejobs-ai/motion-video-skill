{
  "name": "motion-video-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remotion engine for the motion-video-production skill: carry oracle, motion modules, render and voice pipeline",
  "engines": {
    "node": ">=24"
  },
  "scripts": {

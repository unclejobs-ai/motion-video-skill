    "render": "node pipeline/render.mjs",
    "probe": "node pipeline/probe.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "pretendard": "1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "typescript": "5.9.3"
  }
}

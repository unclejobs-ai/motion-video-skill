# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 Git에 올라가지 않습니다.
# 값을 채우지 않아도 웹·CLI 수동 생성 방식으로 제작할 수 있습니다.
# API 연동 자동화를 쓸 때만 필요합니다. 실제 키를 이 파일(.env.example)에 적지 마세요.

# 음성 합성 (ElevenLabs)
ELEVENLABS_KEY=<여기에 본인 키>
ELEVENLABS_VOICE_ID=<고정할 음성 ID>

# 음성 합성 (Fish Audio)
FISH_AUDIO_KEY=<여기에 본인 키>
FISH_AUDIO_VOICE_ID=<고정할 음성 ID>

# 음악 (Suno 등 생성 도구를 API로 쓸 때)
MUSIC_API_KEY=<여기에 본인 키>

# 영상·이미지 생성 API (웹·CLI 구독만 쓰면 비워 둠)
VIDEO_API_KEY=<여기에 본인 키>

# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 Git에 올라가지 않습니다.
# 값을 채우지 않아도 웹·CLI 수동 생성 방식으로 제작할 수 있습니다.
# API 연동 자동화를 쓸 때만 필요합니다. 실제 키를 이 파일(.env.example)에 적지 마세요.

# 음성 합성 (ElevenLabs)
ELEVENLABS_KEY=<여기에 본인 키>
ELEVENLABS_VOICE_ID=<고정할 음성 ID>

# 음성 합성 (Fish Audio)
FISH_AUDIO_KEY=<여기에 본인 키>
FISH_AUDIO_VOICE_ID=<고정할 음성 ID>

# 음악 (Suno 등 생성 도구를 API로 쓸 때)
MUSIC_API_KEY=<여기에 본인 키>

# 영상·이미지 생성 API (웹·CLI 구독만 쓰면 비워 둠)
VIDEO_API_KEY=<여기에 본인 키>

# 목소리 자동화 (engines/remotion/pipeline/vo.mjs, composio CLI)
# composio에 ACTIVE 연결이 여러 개일 때만 고를 계정의 word_id를 적습니다. 하나뿐이면 이 두 줄을 지웁니다(값이 있으면 그 값을 계정으로 씁니다).
# 읽는 방법: node --env-file=.env pipeline/vo.mjs productions/<id>/vo
# 확인: composio link elevenlabs --list / composio link fish_audio --list
COMPOSIO_ACCOUNT_ELEVENLABS=<composio 계정 word_id>
COMPOSIO_ACCOUNT_FISH=<composio 계정 word_id>

# 렌더 브라우저. 쓰지 않으면 이 줄을 지웁니다(캐시된 헤드리스 셸이나 엔진이 받은 브라우저를 씀)
CHROME_PATH=<브라우저 실행 파일 경로>
